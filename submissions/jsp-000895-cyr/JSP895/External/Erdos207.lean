namespace Erdos207

/-- Erdős Problem 207, resolved by Kwan, Sah, Sawhney, and Simkin. -/
theorem erdos_207 :
    ∀ g : ℕ, 2 ≤ g → ∃ N₀ : ℕ, ∀ n : ℕ, N₀ ≤ n → Admissible n →
      ∃ H : TripleSystem n, IsSteiner H ∧ LocallySparse g H := by
  intro g _hg
  obtain ⟨N₀, hN₀⟩ := eventually_highGirthSteinerSystems_pos (g+2) (by omega)
  refine ⟨N₀, ?_⟩
  intro n hn hadmissible
  obtain ⟨H, hsteiner, hgirth⟩ := hN₀ n hn hadmissible
  exact ⟨H, hsteiner, locallySparse_of_girthGreater hgirth⟩

end Erdos207

