'ReciprocalSquares.square_partition' depends on axioms: [propext, Classical.choice, Quot.sound]
'Erdos318.erdos_318.parts.ii' depends on axioms: [propext, Classical.choice, Quot.sound]
ReciprocalSquares.square_partition (X : Set ℕ) (hX : ∃ n, 1 < n ∧ IsSquare n ∧ n ∈ X)
  (hY : ∃ n, 1 < n ∧ IsSquare n ∧ n ∉ X) :
  ∃ A B,
    A.Nonempty ∧
      B.Nonempty ∧
        (∀ n ∈ A, 1 < n ∧ IsSquare n ∧ n ∈ X) ∧
          (∀ n ∈ B, 1 < n ∧ IsSquare n ∧ n ∉ X) ∧ ∑ n ∈ A, 1 / ↑n = ∑ n ∈ B, 1 / ↑n
Erdos318.erdos_318.parts.ii : True ↔ Erdos318.P₁ ({n | IsSquare n} \ {1})
