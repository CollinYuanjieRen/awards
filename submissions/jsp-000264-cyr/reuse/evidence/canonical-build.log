  ∀ (f : ℕ → ℝ),
    (f ∘ Subtype.val ≠ fun x => 1) →
      (f ∘ Subtype.val ≠ fun x => -1) → Set.range f ⊆ {1, -1} → ∃ S, S.Nonempty ∧ ↑S ⊆ A \ {0} ∧ ∑ n ∈ S, f n / ↑n = 0
