Kesten.bounded_remainder_iff (α u v : ℝ) (hα : Irrational α) (hu : 0 ≤ u) (huv : u < v) (hv : v ≤ 1) :
  Kesten.HasBoundedRemainder α u v ↔ ∃ k l, v - u = ↑k * α + ↑l
