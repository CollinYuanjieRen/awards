import MerLeanExperiment.GraphCodeRepresentation
import MerLeanExperiment.ModelAdapters

namespace CochromaticTwenty

/-- The labelled five-cycle with edges 01, 12, 23, 34, and 40. -/
def cycleFive : SimpleGraph (Fin 5) := codeGraph 5 613

instance : DecidableRel cycleFive.Adj := by
  intro u v
  change Decidable ((codeGraph 5 613).Adj u v)
  infer_instance

/-- A concrete certificate is either an actual two-color assignment
or a vertex permutation into `cycleFive`. -/
inductive FiveVertexWitness where
  | coloring (color : Fin 5 → Fin 2)
  | cycle (permutation : Fin 5 → Fin 5)

def FiberCliqueValid (code : ℕ) (color : Fin 5 → Fin 2) (i : Fin 2) : Prop :=
  ∀ u v, color u = i → color v = i → u ≠ v →
    (codeGraph 5 code).Adj u v

def FiberIndependentValid (code : ℕ) (color : Fin 5 → Fin 2)
    (i : Fin 2) : Prop :=
  ∀ u v, color u = i → color v = i → u ≠ v →
    ¬ (codeGraph 5 code).Adj u v

instance (code : ℕ) (color : Fin 5 → Fin 2) (i : Fin 2) :
    Decidable (FiberCliqueValid code color i) := by
  unfold FiberCliqueValid
  letI (u : Fin 5) : Decidable (∀ v : Fin 5,
      color u = i → color v = i → u ≠ v → (codeGraph 5 code).Adj u v) :=
    Fintype.decidableForallFintype
  exact Fintype.decidableForallFintype

instance (code : ℕ) (color : Fin 5 → Fin 2) (i : Fin 2) :
    Decidable (FiberIndependentValid code color i) := by
  unfold FiberIndependentValid
  letI (u : Fin 5) : Decidable (∀ v : Fin 5,
      color u = i → color v = i → u ≠ v → ¬ (codeGraph 5 code).Adj u v) :=
    Fintype.decidableForallFintype
  exact Fintype.decidableForallFintype

def ColoringValid (code : ℕ) (color : Fin 5 → Fin 2) : Prop :=
  ∀ i, FiberCliqueValid code color i ∨ FiberIndependentValid code color i

instance (code : ℕ) (color : Fin 5 → Fin 2) :
    Decidable (ColoringValid code color) := by
  unfold ColoringValid
  exact Fintype.decidableForallFintype

def PermutationValid (permutation : Fin 5 → Fin 5) : Prop :=
  Function.Bijective permutation

instance (permutation : Fin 5 → Fin 5) : Decidable (PermutationValid permutation) := by
  unfold PermutationValid Function.Bijective Function.Injective Function.Surjective
  letI (u : Fin 5) : Decidable (∀ v : Fin 5,
      permutation u = permutation v → u = v) :=
    Fintype.decidableForallFintype
  letI (v : Fin 5) : Decidable (∃ u : Fin 5, permutation u = v) :=
    Fintype.decidableExistsFintype
  letI : Decidable (∀ u v : Fin 5, permutation u = permutation v → u = v) :=
    Fintype.decidableForallFintype
  letI : Decidable (∀ v : Fin 5, ∃ u : Fin 5, permutation u = v) :=
    Fintype.decidableForallFintype
  infer_instance

def CycleAdjValid (code : ℕ) (permutation : Fin 5 → Fin 5) : Prop :=
  ∀ u v, cycleFive.Adj (permutation u) (permutation v) ↔
    (codeGraph 5 code).Adj u v

instance (code : ℕ) (permutation : Fin 5 → Fin 5) :
    Decidable (CycleAdjValid code permutation) := by
  unfold CycleAdjValid
  letI (u : Fin 5) : Decidable (∀ v : Fin 5,
      cycleFive.Adj (permutation u) (permutation v) ↔
        (codeGraph 5 code).Adj u v) :=
    Fintype.decidableForallFintype
  exact Fintype.decidableForallFintype

def FiveVertexWitness.Valid (code : ℕ) : FiveVertexWitness → Prop
  | .coloring color => ColoringValid code color
  | .cycle permutation =>
      PermutationValid permutation ∧ CycleAdjValid code permutation

instance instDecidableFiveVertexWitnessValid (code : ℕ)
    (w : FiveVertexWitness) : Decidable (w.Valid code) := by
  cases w <;> simp only [FiveVertexWitness.Valid] <;> infer_instance

theorem FiveVertexWitness.sound {code : ℕ} (w : FiveVertexWitness)
    (hw : w.Valid code) :
    HasCocoloring (codeGraph 5 code) 2 ∨
      Nonempty (codeGraph 5 code ≃g cycleFive) := by
  cases w with
  | coloring color =>
      refine Or.inl ⟨color, ?_⟩
      have hw' : ColoringValid code color := by
        simpa only [FiveVertexWitness.Valid] using hw
      unfold ColoringValid FiberCliqueValid FiberIndependentValid at hw'
      intro i
      rcases hw' i with h | h
      · exact Or.inl (fun u hu v hv huv ↦ h u v hu hv huv)
      · exact Or.inr (fun u hu v hv huv ↦ h u v hu hv huv)
  | cycle permutation =>
      have hw' : PermutationValid permutation ∧
          CycleAdjValid code permutation := by
        simpa only [FiveVertexWitness.Valid] using hw
      have hp : Function.Bijective permutation := by
        simpa only [PermutationValid] using hw'.1
      have ha : ∀ u v, cycleFive.Adj (permutation u) (permutation v) ↔
          (codeGraph 5 code).Adj u v := by
        simpa only [CycleAdjValid] using hw'.2
      let equiv : Fin 5 ≃ Fin 5 := Equiv.ofBijective permutation hp
      let iso : codeGraph 5 code ≃g cycleFive :=
        { toEquiv := equiv
          map_rel_iff' := by
            intro u v
            change cycleFive.Adj (permutation u) (permutation v) ↔
              (codeGraph 5 code).Adj u v
            exact ha u v }
      exact Or.inr ⟨iso⟩

