theorem witnesses_valid : ∀ code : Fin 1024,
    (witnesses code).Valid code.val := by
  decide +kernel

end FiveVertexData

theorem codeGraph_five_classification (code : Fin 1024) :
    HasCocoloring (codeGraph 5 code.val) 2 ∨
      Nonempty (codeGraph 5 code.val ≃g cycleFive) :=
  (FiveVertexData.witnesses code).sound
    (FiveVertexData.witnesses_valid code)

/-- Every graph on five vertices is two-cocolorable unless it is a
five-cycle. -/
theorem fiveVertexClassification (G : SimpleGraph (Fin 5)) :
    HasCocoloring G 2 ∨ Nonempty (G ≃g cycleFive) := by
  obtain ⟨code, hcode, ⟨e⟩⟩ := exists_bounded_code_iso 5 G
  have hcode' : code < 1024 := by
    norm_num [triangle] at hcode ⊢
    exact hcode
  rcases codeGraph_five_classification ⟨code, hcode'⟩ with hcolor | hcycle
  · exact Or.inl ((hasCocoloring_iso_iff e).mpr hcolor)
  · obtain ⟨f⟩ := hcycle
    exact Or.inr ⟨e.trans f⟩

end CochromaticTwenty

#print axioms CochromaticTwenty.codeGraph_five_classification
#print axioms CochromaticTwenty.fiveVertexClassification
